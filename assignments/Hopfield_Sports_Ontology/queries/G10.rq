PREFIX hs: <urn:hopfield:sports:domain#>
PREFIX hsa: <urn:hopfield:sports:application#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?athlete ?name (COUNT(DISTINCT ?teammate) AS ?teammateCount)
      WHERE {
        ?athlete a hs:Athlete ;
                 rdfs:label ?name ;
                 hs:hasTeammate ?teammate .
      }
      GROUP BY ?athlete ?name
      ORDER BY DESC(?teammateCount) ?name
