  <rdf:Description rdf:nodeID="A146">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
    <sh:message xml:lang="en">validFrom must not be later than an inclusive validTo.</sh:message>
    <sh:select>SELECT $this
WHERE {
  $this &lt;urn:hopfield:sports:domain#validFrom&gt; ?from ;
        &lt;urn:hopfield:sports:domain#validTo&gt; ?to .
  FILTER (?from &gt; ?to)
}
</sh:select>
