  <rdf:Description rdf:about="urn:hopfield:sports:ontology">
    <rdfs:comment xml:lang="en">The ontology includes queryable coverage for the supplied 15 specific and 10 general competency questions. Parameterized questions are answered through SPARQL using the recorded entity IRIs.</rdfs:comment>
    <dcterms:source>MOD004979 Week 1 and Week 2 teaching materials and the two supplied question workbooks.</dcterms:source>
    <dcterms:title xml:lang="en">Hopfield Sports Ontology</dcterms:title>
    <dcterms:creator>Hopfield</dcterms:creator>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-25</dcterms:created>
    <dcterms:rights>The ontology owner must add an explicit distribution licence before public release.</dcterms:rights>
    <dcterms:description xml:lang="en">Version 3.0 completes the ontology coverage needed by the 15 specific and 10 general competency questions. It restores championship counts, adds recorded multi-venue coverage, materializes teammate relations and strengthens SHACL type checks. The data remains a selected teaching dataset.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-29</dcterms:modified>
    <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">urn:hopfield:sports:domain#</vann:preferredNamespaceUri>
    <owl:versionInfo>3.0.0 (2026-10-29)</owl:versionInfo>
    <vann:preferredNamespacePrefix>hs</vann:preferredNamespacePrefix>
    <owl:versionIRI rdf:resource="urn:hopfield:sports:ontology:version:3.0.0"/>
  </rdf:Description>
